# Copy to envs/neo4j.local.env (gitignored) and fill in your password.
# Load before Router / LightRAG benchmarks, e.g.:
#   set -a && source envs/neo4j.local.env && set +a
# (bash/zsh; quoting preserves special characters in passwords.)
#
# Use Bolt URI only — not http://7474 (Neo4j Browser). Typical local Bolt port: 7687.

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
